// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.

// Recommended: your Supabase project host (no https://) and its public anon key.
// The Gemini key then lives ONLY on the server (see backend/README.md).
HF_BACKEND_HOST = your-project-ref.supabase.co
HF_BACKEND_ANON_KEY = your-supabase-anon-key

// Optional, DEBUG builds only: call Gemini straight from the app while prototyping.
// Never ship this — anyone can extract a key from an app binary.
HF_GEMINI_DEV_KEY =
